<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1, which is what SPT 4.1 client plugins target (server side is
         net10.0). Was net471. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>2.0.0</Version>
    <Authors>EchoStarz</Authors>
    <Product>CompoundingPerf.Client</Product>
    <Description>Benchmark-build-only frame-stats recorder for CompoundingPerf. Release builds contain no patches.</Description>
    <RootNamespace>CompoundingPerf.Client</RootNamespace>
    <AssemblyName>CompoundingPerf.Client</AssemblyName>

    <SptRoot Condition="'$(SptRoot)' == ''">E:\SPT 4.1</SptRoot>

    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Dev benchmark builds: dotnet build -p:Bench=true compiles in the C6 frame-stats
       recorder. Release packages are built WITHOUT this flag, so shipped DLLs contain
       no per-frame recorder at all. -->
  <PropertyGroup Condition="'$(Bench)' == 'true'">
    <DefineConstants>$(DefineConstants);BENCH</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-include shared model records from the server project. -->
    <Compile Include="..\Models.cs" Link="Models.cs" />
    <Compile Include="..\FrameStatsMath.cs" Link="FrameStatsMath.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx core -->
    <Reference Include="BepInEx">
      <HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SptRoot)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- SPT helper libraries (publicized EFT internals + reflection helpers) -->
    <Reference Include="spt-reflection">
      <HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-common.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- EFT game assembly. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity. -->
    <Reference Include="UnityEngine">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!--
    Bench builds only. Without -p:Bench=true this project compiles to a plugin that
    installs no patches and measures nothing (everything real in here is #if BENCH), so
    deploying it would drop a do-nothing dll into BepInEx\plugins. That did not matter
    while this project had to be built by hand; it does now that CompoundingPerf.sln
    builds all three projects together.

    Skip via -p:SkipDeploy=true when EFT.exe is running and holding the dll
    memory-mapped — compile still succeeds, just no live deploy.
  -->
  <Target Name="DeployToSpt" AfterTargets="PostBuildEvent" Condition="'$(SkipDeploy)' != 'true' AND '$(Bench)' == 'true'">
    <PropertyGroup>
      <PluginDeployDir>$(SptRoot)\BepInEx\plugins\CompoundingPerf.Client\</PluginDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="false"
          ContinueOnError="WarnAndContinue" />
    <Message Text="Deployed $(TargetFileName) to $(PluginDeployDir)" Importance="high" />
  </Target>


  <!--
    Rule 2-2: every Release build also drops a ready-to-ship archive in release/.
    Skip with -p:SkipPackage=true.
  -->
  <Target Name="PackageRelease" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipPackage)' != 'true'">
    <PropertyGroup>
      <PackageStageDir>$(IntermediateOutputPath)package\</PackageStageDir>
      <PackageZipDir>$(MSBuildThisFileDirectory)release\</PackageZipDir>
      <PackageZipPath>$(PackageZipDir)$(AssemblyName)-$(Version).zip</PackageZipPath>
    </PropertyGroup>
    <ItemGroup>
      <PackageFiles Include="$(OutputPath)**\*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)**\*.deps.json" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="@(PackageFiles)"
          DestinationFiles="@(PackageFiles->'$(PackageStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$(PackageZipDir)" />
    <Delete Files="$(PackageZipPath)" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZipPath)" Overwrite="true" />
    <Message Text="Packaged $(PackageZipPath)" Importance="high" />
  </Target>

</Project>
